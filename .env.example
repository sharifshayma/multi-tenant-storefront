# Copy this file to `.env.local` (for local dev) or set these in your host's
# environment (e.g. Vercel Project Settings). Never commit real values.

# --- Database (PostgreSQL) ---------------------------------------------------
# Pooled + direct connection strings. On Vercel, the Postgres/Supabase/Neon
# integration provisions both automatically. The direct (non-pooling) URL is
# used for Prisma migrations.
POSTGRES_PRISMA_URL="postgres://USER:PASSWORD@HOST:6543/DB?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://USER:PASSWORD@HOST:5432/DB"

# --- Auth (better-auth) ------------------------------------------------------
# A long random secret. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The app's own base URL (no trailing slash), e.g. http://localhost:3000 in dev.
BETTER_AUTH_URL="http://localhost:3000"

# --- File/image uploads (Vercel Blob) ----------------------------------------
# Read/write token from the Vercel Storage tab -> Blob store.
BLOB_READ_WRITE_TOKEN=""

# --- Transactional email (Resend) — optional ---------------------------------
# If RESEND_API_KEY is unset, the app skips sending emails (logs a warning).
RESEND_API_KEY=""
# Verified sender address, e.g. orders@yourdomain.com
RESEND_FROM_EMAIL="orders@example.com"
# Where new-order notifications are sent (the store operator's inbox).
ORDER_NOTIFICATION_EMAIL="you@example.com"
