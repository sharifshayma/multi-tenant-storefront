generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Book {
  id                       String                    @id @default(cuid())
  slug                     String                    @unique
  title                    String
  description              String                    @db.Text
  priceNis                 Int                       @default(40)
  coverImage               String
  position                 Int                       @default(0)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  media                    BookMedia[]
  orderItems               OrderItem[]
  collectionBooks          CollectionBook[]
  orderCollectionItemBooks OrderCollectionItemBook[]

  @@index([position])
}

model Collection {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  title         String
  description   String                 @db.Text
  priceNis      Int
  isCustom      Boolean                @default(false)
  requiredCount Int?
  position      Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  books         CollectionBook[]
  orderItems    OrderCollectionItem[]

  @@index([position])
}

model CollectionBook {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  bookId       String
  book         Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@unique([collectionId, bookId])
}

enum MediaType {
  IMAGE
  VIDEO
}

model BookMedia {
  id        String    @id @default(cuid())
  bookId    String
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([bookId, sortOrder])
}

enum OrderStatus {
  NEW
  CONTACTED
  FULFILLED
}

model Order {
  id              String                 @id @default(cuid())
  customerName    String
  phone           String
  email           String?
  city            String
  notes           String?                @db.Text
  totalNis        Int
  status          OrderStatus            @default(NEW)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  items           OrderItem[]
  collectionItems OrderCollectionItem[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId       String
  book         Book   @relation(fields: [bookId], references: [id])
  quantity     Int
  unitPriceNis Int
}

model OrderCollectionItem {
  id            String                    @id @default(cuid())
  orderId       String
  order         Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collectionId  String
  collection    Collection                @relation(fields: [collectionId], references: [id])
  quantity      Int
  unitPriceNis  Int
  selectedBooks OrderCollectionItemBook[]
}

model OrderCollectionItemBook {
  id                    String              @id @default(cuid())
  orderCollectionItemId String
  orderCollectionItem   OrderCollectionItem @relation(fields: [orderCollectionItemId], references: [id], onDelete: Cascade)
  bookId                String
  book                  Book                @relation(fields: [bookId], references: [id])
}
